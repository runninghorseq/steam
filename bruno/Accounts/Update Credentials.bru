meta {
  name: Update Credentials
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/accounts/76561199000000000/credentials
  body: json
  auth: none
}

headers {
  X-Dashboard-Token: {{token}}
  Content-Type: application/json
}

body:json {
  {
    "email": "a@x.com",
    "email_password": "",
    "steam_password": "",
    "email_refresh_token": "",
    "email_client_id": "",
    "refresh_token": ""
  }
}

docs {
  Set editable credential fields (empty string clears a field).
}
