meta {
  name: Ingest
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/ingest
  body: json
  auth: none
}

headers {
  X-Dashboard-Token: {{token}}
  Content-Type: application/json
}

body:json {
  {
    "op": "accountNames"
  }
}

docs {
  Box -> Worker data-plane RPC. {op, ...args}. Normally only the box calls this.
}
