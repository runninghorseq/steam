meta {
  name: Email Tokens (attach)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/email-tokens
  body: json
  auth: none
}

headers {
  X-Dashboard-Token: {{token}}
  Content-Type: application/json
}

body:json {
  {
    "text": "mail@x.com|pass|refresh_token|app_id"
  }
}

docs {
  Attach mailbox OAuth tokens to existing accounts, matched by email.
}
