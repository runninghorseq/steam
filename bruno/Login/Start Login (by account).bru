meta {
  name: Start Login (by account)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/accounts/76561199000000000/login
  body: json
  auth: none
}

headers {
  X-Dashboard-Token: {{token}}
  Content-Type: application/json
}

body:json {
  {
    "password": "the-steam-password"
  }
}

docs {
  Start an interactive login to cache a refresh token. Returns a session id.
}
